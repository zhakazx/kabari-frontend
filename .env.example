# ---- Server-only (NEVER prefix with NEXT_PUBLIC_) ----
# NestJS backend base URL, including the /api/v1 prefix, no trailing slash.
API_BASE_URL=http://localhost:8080/api/v1

# Signs/encrypts the kabari_session cookie (jose HS256). Generate with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-openssl-rand-base64-32

# Cookie name and lifetime (seconds). Default 604800 = 7 days.
SESSION_COOKIE_NAME=kabari_session
SESSION_MAX_AGE_SECONDS=604800

# ---- Client-exposed (NEXT_PUBLIC_ prefix) ----
# Branding shown in the UI.
NEXT_PUBLIC_APP_NAME=KABARI

# WebSocket/SSE gateway for realtime dashboards (Phase 9). Optional for now.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3000
